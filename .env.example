# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase publishable/anon key (safe for browser use)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only Supabase secret/service-role key. Never use NEXT_PUBLIC_ here.
SUPABASE_SECRET_KEY=YOUR_SERVER_SIDE_SUPABASE_SECRET_KEY

# Long random secret used to protect gift access. Keep stable after publishing gifts.
GIFT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Resend API key, server-side only. Required for the postcard email; without it the
# postcard section reports that email is not configured and nothing else is affected.
RESEND_API_KEY=re_REPLACE_WITH_YOUR_KEY

# Optional. The verified sender the postcards come from. Must be a domain you have
# verified with Resend, or onboarding@resend.dev for testing.
RESEND_FROM=Afterglow <you@your-verified-domain.com>
