# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase publishable/anon key (safe for browser use)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only Supabase secret/service-role key. Never use NEXT_PUBLIC_ here.
SUPABASE_SECRET_KEY=YOUR_SERVER_SIDE_SUPABASE_SECRET_KEY

# Long random secret used to protect gift access. Keep stable after publishing gifts.
GIFT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# ---------------------------------------------------------------------------------------------
# Postcard email. Optional: with nothing set here, the postcard section reports that email is
# not configured and every other feature works normally. Whichever key is present is used.
# ---------------------------------------------------------------------------------------------

# Brevo. Free, and needs no domain: confirm a single sender address by email and it works.
# Sending is tried through Resend first if that key is also set, so adding your own domain
# later switches providers on its own.
BREVO_API_KEY=xkeysib-REPLACE_WITH_YOUR_KEY

# The sender Brevo sends from. MUST be an address you have confirmed under
# Brevo -> Senders, Domains & Dedicated IPs -> Senders. It need not be a domain you own.
BREVO_FROM=Afterglow <you@example.com>

# Resend. Better free allowance, but its free tier will only deliver to your own signup
# address until you verify a domain you own.
RESEND_API_KEY=re_REPLACE_WITH_YOUR_KEY

# The sender Resend sends from. An address at a domain you have verified with Resend.
RESEND_FROM=Afterglow <you@your-verified-domain.com>

# Optional. "brevo" or "resend" to force one provider when both keys above are set.
# EMAIL_PROVIDER=brevo
